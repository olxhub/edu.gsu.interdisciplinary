<!--
  Homelessness SBA, Part 2 (slides 203-311 of "Homelessness SBA Storyboard_2
  (v Oct 13).pptx"). Same layout as Part 1 (../part1/hs_sba_part1.olx):

    Discussion   the scripted conversation (hs_dialogue_part2.chatpeg) on the
                 left; the activity pane (UseHistory hs2_main) on the right,
                 driven by target embeds that leave labelled buttons in the
                 transcript.
    Team         the Comm360 team directory.

  Every screen and question is in hs_activities_part2.olx. The study summaries
  (readings/*_full.md) and the cast (characters.cast, images/) are copies of
  Part 1's, so this folder is self-contained.
-->

<Tabs id="hs_sba_part2" title="Homelessness SBA, Part 2 — Integrating Disciplinary Insights" launchable="true">

  <Vertical id="hs2_tab_main" title="Discussion">
    <SplitPanel id="hs2_split" sizes="40, 60">
      <StartPane>
        <Chat id="hs2_chat"
              src="hs_dialogue_part2.chatpeg"
              cast="characters.cast"
              height="560px" />
      </StartPane>
      <EndPane>
        <UseHistory id="hs2_main" initial="hs2_welcome" />
      </EndPane>
    </SplitPanel>
  </Vertical>

  <Vertical id="hs2_tab_team" title="Team">
    <TeamDirectory id="hs2_team_tab_directory" cast="characters.cast" title="Comm360 Team" />
  </Vertical>

</Tabs>
